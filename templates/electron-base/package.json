{
  "name": "web2app-template",
  "productName": "Web2App",
  "version": "1.0.0",
  "description": "Generated by Web2App Builder",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.web2app.template",
    "productName": "Web2App",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "chrome.html", "chrome-preload.js", "theme.css", "config.json", "icon.*", "package.json"],
    "win": { "target": "nsis", "icon": "icon.ico" },
    "mac": { "target": "dmg", "icon": "icon.icns" },
    "linux": { "target": "AppImage", "icon": "icon.png" }
  }
}
